  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Profile": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "username",
          "display_name",
          "role",
          "enabled"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "role": {
            "enum": [
              "member",
              "manager",
              "admin"
            ]
          },
          "enabled": {
            "type": "boolean"
          }
        }
      },
      "Token": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "token",
          "token_type",
          "expires_in"
        ],
        "properties": {
          "token": {
            "type": "string"
          },
          "token_type": {
            "const": "Bearer"
          },
          "expires_in": {
            "const": 28800
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "fields": {
                "type": "object"
              }
            }
          }
        }
      },
      "Stored_id": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      },
      "Stored_shortText": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120,
        "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
      },
      "Stored_movie": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "year",
